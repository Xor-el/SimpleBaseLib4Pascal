<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <CompatibilityMode Value="True"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="SimpleBaseLib.Tests.Android"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages Count="3">
      <Item1>
        <PackageName Value="SimpleBaseLib4PascalPackage"/>
      </Item1>
      <Item2>
        <PackageName Value="FCL"/>
      </Item2>
      <Item3>
        <PackageName Value="LazTestInsight"/>
      </Item3>
    </RequiredPackages>
    <Units Count="1">
      <Unit0>
        <Filename Value="SimpleBaseLib.Tests.Android.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <PathDelim Value="\"/>
    <Target>
      <Filename Value=".\bin\libSimpleBaseLibAndroidTests.so"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir)"/>
      <OtherUnitFiles Value="..\src;..\src\Base64;..\src\Multibase;..\src\Misc;..\src\Base85;..\src\Base8;..\src\Base62;..\src\Base58;..\src\Base45;..\src\Base32;..\src\Base2;..\src\Base16;..\src\Base10;..\src\Base36;..\src\Coders;Mobile\Android"/>
      <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <CodeGeneration>
      <TargetCPU Value="aarch64"/>
      <TargetOS Value="android"/>
    </CodeGeneration>
    <Linking>
      <Options>
        <ExecutableType Value="Library"/>
      </Options>
    </Linking>
    <Other>
      <ConfigFile>
        <CustomConfigFile Value="True"/>
        <ConfigFilePath Value="..\..\BuildConfig\FPC\SimpleBaseLibFPCMessages.cfg"/>
      </ConfigFile>
      <ExecuteAfter>
        <Command Value="java &quot;$(ProjPath)Mobile/Android/BuildApk.java&quot; --project-dir &quot;$(ProjPath).&quot; --library SimpleBaseLibAndroidTests --app-id simplebaselib --title &quot;SimpleBaseLib Tests&quot; --target-os $(TargetOS)"/>
      </ExecuteAfter>
    </Other>
  </CompilerOptions>
</CONFIG>
